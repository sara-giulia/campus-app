      "name": "Listings",
      "item": [
        {
          "name": "CreateListing",
          "item": [
            {
              "name": "Create listing - valid (201 + Location)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/listings",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "listings"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"sellerId\": \"{{sellerId}}\",\n  \"title\": \"Calculus textbook\",\n  \"category\": \"Textbook\",\n  \"condition\": \"Good\",\n  \"price\": 40\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                      "pm.test(\"Location header points to the new listing\", () => {",
                      "  const id = pm.response.json().id;",
                      "  pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/v1/listings/\" + id);",
                      "});",
                      "pm.test(\"New listing starts as Draft, version 1\", () => {",
                      "  const body = pm.response.json();",
                      "  pm.expect(body.status).to.eql(\"Draft\");",
                      "  pm.expect(body.version).to.eql(1);",
                      "});",
                      "pm.collectionVariables.set(\"listingId\", pm.response.json().id);"
                    ]
                  }
                }
              ]
            },

{
  "Logging": {
    "Console": {
      "IncludeScopes": true
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CampusMarket": "Data Source=campusmarket.db"
  },

  "Ml": {
    "Category": { "MinConfidence": 0.6 },
    "Spam": { "Threshold": 0.4 }
  },

  "Jwt": {
    "Issuer": "CampusMarket",
    "Audience": "CampusMarket",
    "ExpiresMinutes": 15
  },

  "LiveEvents": {
    "HeartbeatSeconds": 25
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}

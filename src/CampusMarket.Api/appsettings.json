{
  "Logging": {
    "Console": {
      "IncludeScopes": true
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CampusMarket": "Data Source=campusmarket.db"
  },

  "Jwt": {
    "Issuer": "CampusMarket",
    "Audience": "CampusMarket",
    "ExpiresMinutes": 15
  }
}

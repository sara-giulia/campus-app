{
  "Logging": {
    "Console": {
      "IncludeScopes": true
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Ml": {
    "Category": { "MinConfidence": 0.6 },
    "Spam": { "Threshold": 0.35 },
    "MessageSpam": { "Threshold": 0.6, "BlockThreshold": 0.95 }
  },

  "Jwt": {
    "Issuer": "CampusMarket",
    "Audience": "CampusMarket",
    "ExpiresMinutes": 15
  },

  "Listings": {
    "ExpiryDays": 30
  },

  "ListingExpiry": {
    "Enabled": true,
    "Interval": "01:00:00"
  },

  "LiveEvents": {
    "HeartbeatSeconds": 25
  },

  "ImageGeneration": {
    "Enabled": true,
    "Provider": "Svg",
    "Ollama": { "BaseUrl": "http://localhost:11434", "Model": "x/z-image-turbo", "TimeoutSeconds": 120 }
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
